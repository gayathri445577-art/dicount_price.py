class Solution:
    def finalPrices(self, prices: list[int]) -> list[int]:

        answer = []

        for i in range(len(prices)):

            for j in range(i + 1, len(prices)):

                if prices[j] <= prices[i]:
                    final_price = prices[i] - prices[j]
                    break

            else:
                final_price = prices[i]

            answer.append(final_price)

        return answer
